{
  "name": "questboard",
  "version": "0.0.0",
  "description": "Local-first shared work board for humans and multiple AI agents.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "chatgpt2codex": {
    "managedService": {
      "launch": {
        "command": "node",
        "args": ["dist/src/server/main.js", "--tailnet", "--managed-service"],
        "cwdRelative": ".",
        "inheritEnvKeys": [
          "QUESTBOARD_DB_PATH",
          "QUESTBOARD_IDENTITY_PATH",
          "QUESTBOARD_PORT",
          "QUESTBOARD_CONCURRENCY_LOG"
        ]
      },
      "health": {
        "url": "http://127.0.0.1:4318/health",
        "timeoutMs": 15000
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:web": "node --check web/app.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "daemon": "node dist/src/server/main.js --tailnet",
    "daemon:local": "node dist/src/server/main.js",
    "daemon:tailnet": "node dist/src/server/main.js --tailnet",
    "start": "node dist/src/server/main.js --tailnet",
    "start:local": "node dist/src/server/main.js",
    "start:tailnet": "node dist/src/server/main.js --tailnet",
    "cli": "node dist/src/adapters/cli/main.js",
    "mcp": "node dist/src/adapters/mcp/main.js",
    "test:race": "npm run build && node dist/src/testing/claim-race-main.js",
    "verify": "npm run typecheck && npm run check:web && npm test && npm run test:race"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
